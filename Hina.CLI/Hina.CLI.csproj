<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="..\img\HinaPack_Logo.ico" Link="HinaPack_Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hina.CLI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hina.Core\Hina.Core.csproj" />
    <ProjectReference Include="..\Hina.PackageManager\Hina.PackageManager.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\img\HinaPack_Logo.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <PackageIcon>HinaPack_Logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\img\HinaPack_Logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    macOS NativeAOT links against system OpenSSL via -lssl/-lcrypto. macOS doesn't ship
    OpenSSL headers/libs in the SDK, so we point the linker at Homebrew's openssl@3.
    Both Apple Silicon (/opt/homebrew) and Intel (/usr/local) brew prefixes are tried;
    GitHub Actions macos-latest runners have brew openssl@3 pre-installed at the
    Apple-Silicon prefix.
  -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <LinkerArg Include="-L/opt/homebrew/opt/openssl@3/lib" Condition="Exists('/opt/homebrew/opt/openssl@3/lib')" />
    <LinkerArg Include="-L/usr/local/opt/openssl@3/lib" Condition="Exists('/usr/local/opt/openssl@3/lib')" />
    <LinkerArg Include="-L/opt/homebrew/opt/brotli/lib" Condition="Exists('/opt/homebrew/opt/brotli/lib')" />
    <LinkerArg Include="-L/usr/local/opt/brotli/lib" Condition="Exists('/usr/local/opt/brotli/lib')" />
  </ItemGroup>

</Project>
