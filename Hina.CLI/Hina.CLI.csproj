<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="..\img\HinaPack_Logo.ico" Link="HinaPack_Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hina.Core\Hina.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\img\HinaPack_Logo.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PackageIcon>HinaPack_Logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\img\HinaPack_Logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
